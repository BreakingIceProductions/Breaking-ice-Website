# Sanity (public: safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=8rusxi8t
NEXT_PUBLIC_SANITY_DATASET=production

# Pre-launch password for the whole site (leave empty to turn the lock off)
SITE_USER=breakingice
SITE_PASSWORD=

# Contact form destinations. Each one switches on when its value is set.
# With none set, the form tells visitors to email instead (nothing is lost).
#
# Email (resend.com, free tier is plenty; verify breakingiceproductions.com there first)
RESEND_API_KEY=
CONTACT_TO=josh@breakingiceproductions.com
CONTACT_FROM=Breaking Ice website <website@breakingiceproductions.com>
# Slack: create an Incoming Webhook for the channel you want
SLACK_WEBHOOK_URL=
# Google Sheet: see docs/google-sheet-webhook.gs for the 5-minute setup
SHEET_WEBHOOK_URL=
SHEET_WEBHOOK_SECRET=

# ── Client portal (all server-side; see docs/portal-setup.md) ─────────────────
# Long random string that signs sign-in links, codes and sessions. Required.
PORTAL_SECRET=
# Sanity token with Editor access (sanity.io/manage → API → Tokens). Required.
SANITY_PORTAL_TOKEN=
# Google service account JSON (paste raw or base64) that's a member of the Shared Drive.
# Keyless Google access (preferred): Workload Identity Federation with Vercel's OIDC token.
# GOOGLE_WIF_PROVIDER=projects/<number>/locations/global/workloadIdentityPools/vercel/providers/vercel
# GOOGLE_SERVICE_ACCOUNT_EMAIL=portal@<project>.iam.gserviceaccount.com
# Or, if your Google org allows keys, the service account's JSON key instead:
GOOGLE_SERVICE_ACCOUNT=
# The Shared Drive's ID (the last part of its address in Google Drive).
GOOGLE_SHARED_DRIVE_ID=
# Vimeo personal access token (developer.vimeo.com/apps → Generate token; scopes: Public, Private).
# Fills in thumbnails, lengths and the player, and spots new versions when you Replace video.
VIMEO_ACCESS_TOKEN=
# Shared secret for the 10-minute scheduler (also add it as a GitHub Actions secret).
CRON_SECRET=
# Optional: who portal emails come from / replies go to.
# PORTAL_FROM=Josh Ferguson, Breaking Ice <josh@breakingiceproductions.com>
# PORTAL_REPLY_TO=josh@breakingiceproductions.com
# Set to "off" to hide "See a sample project" on the sign-in page.
# PORTAL_DEMO=off

# ── Back office (/admin; see /admin/settings for step-by-step setup) ──────────
# Uses PORTAL_SECRET, SANITY_PORTAL_TOKEN and RESEND_API_KEY from above for sign-in.
# Who can sign in (comma-separated).
ADMIN_EMAILS=josh@breakingiceproductions.com
# Zoho Books server-based client (api-console.zohocloud.ca). Redirect URI: <site>/api/admin/connect/zoho/callback
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
# Optional: income account ID for invoice lines (default Sales), a tax ID such as GST (default none), days until due (default 30).
# ZOHO_ACCOUNT_ID=
# ZOHO_TAX_ID=
# ZOHO_DUE_DAYS=30
# Only for a Zoho account outside Canada, or one with several organisations.
# ZOHO_ACCOUNTS_URL=https://accounts.zohocloud.ca
# ZOHO_API_URL=https://www.zohoapis.ca
# ZOHO_BOOKS_URL=https://books.zohocloud.ca
# ZOHO_ORG_ID=
# TickTick app (developer.ticktick.com/manage). Redirect URL: <site>/api/admin/connect/ticktick/callback
TICKTICK_CLIENT_ID=
TICKTICK_CLIENT_SECRET=
# The "Breaking Ice Projects" calendar ID, shared with GOOGLE_SERVICE_ACCOUNT ("Make changes to events").
GOOGLE_CALENDAR_ID=
